# Copy to .env and fill in your own values. The server reads these at boot.
# All keys are USER_ prefixed so they never collide with platform-provided
# environment variables. None are bundled with the app — bring your own keys.

# ---------- Supabase (database / storage backend) ----------
# Create a project at https://supabase.com, then create two tables:
#   leads (id text pk, data jsonb, updated_at timestamptz default now())
#   app_state (key text pk, data jsonb, updated_at timestamptz default now())
# and insert one row into app_state: key = 'app', data = {} (any jsonb).
USER_SUPABASE_URL=
USER_SUPABASE_ANON_KEY=

# ---------- Supabase Auth (login) ----------
# Same project as USER_SUPABASE_URL above. Get the service role key from
# Project Settings > API > service_role secret — NEVER expose this to the
# frontend, it bypasses row-level security.
USER_SUPABASE_SERVICE_ROLE_KEY=

# Frontend build-time vars (Vite requires the VITE_ prefix). Same project
# URL/anon key as USER_SUPABASE_URL / USER_SUPABASE_ANON_KEY above.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------- OpenAI GPT (AI enrichment) ----------
# https://platform.openai.com/api-keys
USER_OPENAI_API_KEY=
USER_OPENAI_MODEL=gpt-4o-mini

# ---------- Respond.io (WhatsApp / SMS / email messaging) ----------
# https://app.respond.io/settings/api
USER_RESPONDIO_API_KEY=
USER_RESPONDIO_WORKSPACE_ID=

# ---------- Mailtrap (email alerts / reminders) ----------
# SMTP inbox or sending domain credentials from https://mailtrap.io
USER_MAILTRAP_HOST=sandbox.smtp.mailtrap.io
USER_MAILTRAP_PORT=2525
USER_MAILTRAP_USER=
USER_MAILTRAP_PASS=
USER_MAILTRAP_FROM_EMAIL=studio@physique57.in
USER_MAILTRAP_FROM_NAME=Physique 57 Lead Studio

# ---------- Momence ----------
# These can also be configured in Settings > Integrations instead of here.
USER_MOMENCE_CLIENT_ID=
USER_MOMENCE_CLIENT_SECRET=
USER_MOMENCE_USERNAME=
USER_MOMENCE_PASSWORD=
USER_MOMENCE_HOST_ID=
USER_MOMENCE_CLIENT_ID_BLR=
USER_MOMENCE_CLIENT_SECRET_BLR=
USER_MOMENCE_USERNAME_BLR=
USER_MOMENCE_PASSWORD_BLR=
USER_MOMENCE_HOST_ID_BLR=33905
MOMENCE_ALL_COOKIES=
MOMENCE_ALL_COOKIES_BLR=
